#include <windows.h>

1 ICON "Lviewer.ico"
1 24 "Lviewer.manifest"

LANG_JA RCDATA "lang/ja.ini"
LANG_EN RCDATA "lang/en.ini"
LANG_TH RCDATA "lang/th.ini"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Lviewer - fast image viewer"
            VALUE "FileVersion", "1.1.0"
            VALUE "InternalName", "Lviewer"
            VALUE "OriginalFilename", "Lviewer.exe"
            VALUE "ProductName", "Lviewer"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
